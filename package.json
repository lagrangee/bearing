{
  "name": "@lagrangee/bearing",
  "version": "0.1.0",
  "description": "Local-first project governance for coding agents.",
  "type": "module",
  "bin": {
    "bearing": "dist/cli.js"
  },
  "files": [
    "dist",
    "docs/cli.md",
    "docs/cli.zh-CN.md",
    "docs/data-and-security.md",
    "docs/data-and-security.zh-CN.md",
    "docs/everyday-workflows.md",
    "docs/everyday-workflows.zh-CN.md",
    "docs/getting-started.md",
    "docs/getting-started.zh-CN.md",
    "docs/troubleshooting.md",
    "docs/troubleshooting.zh-CN.md",
    "skills",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES",
    "SECURITY.md",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "scripts": {
    "build": "bun scripts/build.ts",
    "benchmark:inspect": "bun run build && bun scripts/benchmark-inspect.ts",
    "benchmark:sync": "bun scripts/benchmark-sync.ts",
    "check": "biome check .",
    "dev:ui": "vite",
    "test": "bun run build && bun test tests/*.test.ts && bun run test:catalog-node",
    "test:catalog-node": "bun scripts/run-node-catalog-tests.ts",
    "test:g1-regression": "bun run build && bun scripts/g1-regression-core.ts",
    "test:g2-regression": "bun run build && bun scripts/g2-regression-core.ts",
    "test:g2-zero-intrusion": "bun run build && bun test tests/zero-intrusion-proof.test.ts tests/github-packaged-product-journey.test.ts tests/github-provider.test.ts tests/github-provider-architecture.test.ts tests/local-markdown-provider-architecture.test.ts",
    "test:g2-local-validation": "bun run build && bun test tests/g2-local-validation-matrix.test.ts tests/local-packaged-product-journey.test.ts tests/sync-benchmark.test.ts tests/inspect-benchmark.test.ts tests/zero-intrusion-proof.test.ts",
    "test:browser": "bun run build && playwright test",
    "typecheck": "tsc --noEmit",
    "verify": "bun run typecheck && bun run check && bun run build && bun test tests/*.test.ts && bun run test:catalog-node && bun run test:g2-regression",
    "prepack": "bun run build",
    "package:check": "bun scripts/check-package-boundary.ts",
    "license:check": "bun scripts/check-dependency-licenses.ts",
    "secret:scan": "bun scripts/check-secret-boundary.ts",
    "candidate:prepare": "bun scripts/prepare-release-candidate.ts",
    "candidate:verify": "bun scripts/verify-release-candidate.ts",
    "release:smoke": "node scripts/release-smoke.mjs"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.3.11",
    "@hono/node-server": "^2.0.8",
    "@playwright/test": "^1.61.1",
    "@types/markdown-it": "14.1.2",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "^6.0.3",
    "bun-types": "^1.3.5",
    "deep-freeze-es6": "^5.0.0",
    "fuse.js": "^7.3.0",
    "hono": "^4.12.30",
    "lucide-react": "^1.24.0",
    "markdown-it": "14.1.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-markdown": "^2.1.2",
    "mdast-util-to-string": "^4.0.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "parse-headers": "^2.0.6",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-grab": "^0.1.48",
    "safe-stable-stringify": "^2.5.0",
    "sanitize-html": "2.17.0",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.1.4",
    "yaml": "^2.8.1",
    "zod": "^4.2.1"
  },
  "license": "MIT",
  "author": "lagrangee",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lagrangee/bearing.git"
  },
  "homepage": "https://github.com/lagrangee/bearing#readme",
  "bugs": {
    "url": "https://github.com/lagrangee/bearing/issues"
  },
  "keywords": [
    "agent-skills",
    "codex",
    "claude-code",
    "project-governance",
    "planning",
    "local-first",
    "coding-agents",
    "cli",
    "portal"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
